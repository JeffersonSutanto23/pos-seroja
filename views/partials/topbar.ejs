<header class="bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between sticky top-0 z-10">
  <div>
    <h1 class="text-xl font-bold text-slate-800"><%= title %></h1>
    <% if (typeof subtitle !== 'undefined' && subtitle) { %>
      <p class="text-sm text-slate-500"><%= subtitle %></p>
    <% } %>
  </div>
  <div class="text-sm text-slate-400"><%= new Date().toLocaleDateString('id-ID', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %></div>
</header>
