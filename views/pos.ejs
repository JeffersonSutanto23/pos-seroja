<%- include('partials/layout-head', { title: 'Kasir' }) %>
<body class="bg-slate-50">
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 min-h-screen flex flex-col">
    <%- include('partials/topbar', { title: 'Kasir (POS)', subtitle: 'Buat transaksi penjualan baru' }) %>

    <div class="flex-1 grid grid-cols-1 lg:grid-cols-3 gap-4 p-6">
      <!-- Product list -->
      <div class="lg:col-span-2 card p-4 flex flex-col">
        <input id="searchInput" type="text" placeholder="Cari produk / SKU..."
          class="w-full border border-slate-300 rounded-lg px-4 py-2.5 mb-4 focus:outline-none focus:ring-2 focus:ring-brand-500">
        <div id="productGrid" class="grid grid-cols-2 md:grid-cols-3 gap-3 overflow-y-auto" style="max-height:70vh">
          <% products.forEach(p => { %>
            <button type="button" class="product-card text-left border border-slate-200 rounded-xl p-3 hover:border-brand-500 hover:shadow-md transition bg-white"
              data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.sell_price %>" data-stock="<%= p.stock %>" data-unit="<%= p.unit %>"
              data-search="<%= (p.name + ' ' + (p.sku||'')).toLowerCase() %>">
              <div class="font-semibold text-sm text-slate-800 leading-tight"><%= p.name %></div>
              <div class="text-xs text-slate-400 mt-1"><%= p.sku || '-' %> · Stok: <%= p.stock %> <%= p.unit %></div>
              <div class="text-brand-700 font-bold mt-2">Rp <%= rupiah(p.sell_price) %></div>
            </button>
          <% }) %>
        </div>
      </div>

      <!-- Cart & checkout -->
      <div class="card p-4 flex flex-col">
        <h3 class="font-bold text-slate-800 mb-3">🛍️ Keranjang</h3>
        <div id="cartList" class="flex-1 overflow-y-auto space-y-2" style="max-height:32vh">
          <p id="emptyCart" class="text-sm text-slate-400 text-center py-8">Belum ada item</p>
        </div>

        <div class="border-t border-slate-200 mt-3 pt-3 space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-slate-500">Subtotal</span><span id="subtotalText" class="font-semibold">Rp 0</span></div>
          <div class="flex justify-between items-center">
            <span class="text-slate-500">Diskon</span>
            <input id="discountInput" type="number" min="0" value="0" class="w-28 border border-slate-300 rounded-lg px-2 py-1 text-right">
          </div>
          <div class="flex justify-between text-lg font-extrabold text-brand-700"><span>Total</span><span id="totalText">Rp 0</span></div>
        </div>

        <div class="border-t border-slate-200 mt-3 pt-3 space-y-3">
          <div>
            <label class="text-xs font-semibold text-slate-600 uppercase">Jenis Pembayaran</label>
            <div class="flex gap-2 mt-1">
              <button type="button" data-type="cash" class="paytype-btn flex-1 py-2 rounded-lg border border-slate-300 font-semibold text-sm">Cash</button>
              <button type="button" data-type="credit" class="paytype-btn flex-1 py-2 rounded-lg border border-slate-300 font-semibold text-sm">Credit</button>
            </div>
          </div>

          <div id="customerSection">
            <label class="text-xs font-semibold text-slate-600 uppercase">Customer <span id="customerRequired" class="text-red-500 hidden">*wajib</span></label>
            <select id="customerSelect" class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1">
              <option value="">-- Umum / Tanpa Nama --</option>
              <% customers.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
            </select>
            <input id="newCustomerName" type="text" placeholder="Atau ketik nama customer baru..." class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-2">
          </div>

          <div>
            <label class="text-xs font-semibold text-slate-600 uppercase">Metode Pembayaran</label>
            <div class="grid grid-cols-3 gap-2 mt-1">
              <button type="button" data-method="cash" class="method-btn py-2 rounded-lg border border-slate-300 text-xs font-semibold">💵 Tunai</button>
              <button type="button" data-method="transfer_bca" class="method-btn py-2 rounded-lg border border-slate-300 text-xs font-semibold">🏦 Transfer BCA</button>
              <button type="button" data-method="qris" class="method-btn py-2 rounded-lg border border-slate-300 text-xs font-semibold">📱 QRIS</button>
            </div>
          </div>

          <div id="paidAmountSection" class="hidden">
            <label class="text-xs font-semibold text-slate-600 uppercase">Bayar (DP, jika ada)</label>
            <input id="paidAmountInput" type="number" min="0" value="0" class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1">
          </div>

          <p id="errorBox" class="text-sm text-red-600 hidden"></p>

          <button id="checkoutBtn" class="w-full bg-accent-500 hover:bg-accent-600 text-white font-bold rounded-lg py-3 transition shadow-md disabled:opacity-40">
            Proses & Cetak Struk
          </button>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
let cart = [];
let payType = 'cash';
let payMethod = 'cash';

const productCards = document.querySelectorAll('.product-card');
const searchInput = document.getElementById('searchInput');
searchInput.addEventListener('input', () => {
  const q = searchInput.value.toLowerCase();
  productCards.forEach(c => c.style.display = c.dataset.search.includes(q) ? '' : 'none');
});

productCards.forEach(card => card.addEventListener('click', () => {
  const id = card.dataset.id;
  const existing = cart.find(i => i.product_id === id);
  const stock = Number(card.dataset.stock);
  if (existing) {
    if (existing.qty + 1 > stock) return alert('Stok tidak cukup');
    existing.qty += 1;
  } else {
    if (stock < 1) return alert('Stok kosong');
    cart.push({ product_id: id, name: card.dataset.name, price: Number(card.dataset.price), qty: 1, unit: card.dataset.unit, stock });
  }
  renderCart();
}));

function renderCart() {
  const list = document.getElementById('cartList');
  const empty = document.getElementById('emptyCart');
  list.innerHTML = '';
  if (cart.length === 0) { list.appendChild(empty); }
  else {
    cart.forEach((item, idx) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 border border-slate-200 rounded-lg p-2';
      row.innerHTML = `
        <div class="flex-1">
          <div class="text-sm font-semibold text-slate-800">${item.name}</div>
          <div class="text-xs text-slate-400">Rp ${fmt(item.price)} / ${item.unit}</div>
        </div>
        <input type="number" min="1" max="${item.stock}" value="${item.qty}" data-idx="${idx}" class="qty-input w-16 border border-slate-300 rounded px-1 py-1 text-center text-sm">
        <button data-idx="${idx}" class="remove-btn text-red-400 hover:text-red-600 px-1">✕</button>
      `;
      list.appendChild(row);
    });
    list.querySelectorAll('.qty-input').forEach(inp => inp.addEventListener('change', e => {
      const idx = e.target.dataset.idx;
      let val = Number(e.target.value);
      if (val > cart[idx].stock) { val = cart[idx].stock; alert('Stok tidak cukup'); }
      if (val < 1) val = 1;
      cart[idx].qty = val;
      renderCart();
    }));
    list.querySelectorAll('.remove-btn').forEach(btn => btn.addEventListener('click', e => {
      cart.splice(e.target.dataset.idx, 1);
      renderCart();
    }));
  }
  updateTotals();
}

function fmt(n) { return Number(n).toLocaleString('id-ID'); }

function updateTotals() {
  const subtotal = cart.reduce((s, i) => s + i.price * i.qty, 0);
  const discount = Number(document.getElementById('discountInput').value) || 0;
  const total = Math.max(subtotal - discount, 0);
  document.getElementById('subtotalText').textContent = 'Rp ' + fmt(subtotal);
  document.getElementById('totalText').textContent = 'Rp ' + fmt(total);
}
document.getElementById('discountInput').addEventListener('input', updateTotals);

document.querySelectorAll('.paytype-btn').forEach(btn => btn.addEventListener('click', () => {
  payType = btn.dataset.type;
  document.querySelectorAll('.paytype-btn').forEach(b => b.classList.remove('bg-brand-600','text-white','border-brand-600'));
  btn.classList.add('bg-brand-600','text-white','border-brand-600');
  document.getElementById('customerRequired').classList.toggle('hidden', payType !== 'credit');
  document.getElementById('paidAmountSection').classList.toggle('hidden', payType !== 'credit');
}));

document.querySelectorAll('.method-btn').forEach(btn => btn.addEventListener('click', () => {
  payMethod = btn.dataset.method;
  document.querySelectorAll('.method-btn').forEach(b => b.classList.remove('bg-brand-600','text-white','border-brand-600'));
  btn.classList.add('bg-brand-600','text-white','border-brand-600');
}));

document.querySelector('.paytype-btn[data-type="cash"]').click();
document.querySelector('.method-btn[data-method="cash"]').click();

document.getElementById('checkoutBtn').addEventListener('click', async () => {
  const errorBox = document.getElementById('errorBox');
  errorBox.classList.add('hidden');
  if (cart.length === 0) { errorBox.textContent = 'Keranjang masih kosong.'; errorBox.classList.remove('hidden'); return; }

  const customerId = document.getElementById('customerSelect').value;
  const newCustomerName = document.getElementById('newCustomerName').value.trim();
  if (payType === 'credit' && !customerId && !newCustomerName) {
    errorBox.textContent = 'Nama customer wajib diisi untuk transaksi kredit.';
    errorBox.classList.remove('hidden');
    return;
  }

  const payload = {
    items: JSON.stringify(cart.map(i => ({ product_id: i.product_id, qty: i.qty }))),
    payment_type: payType,
    payment_method: payMethod,
    customer_id: customerId,
    new_customer_name: newCustomerName,
    discount: document.getElementById('discountInput').value,
    paid_amount: document.getElementById('paidAmountInput').value,
  };

  const res = await fetch('/pos/checkout', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams(payload),
  });
  const data = await res.json();
  if (!res.ok) {
    errorBox.textContent = data.error || 'Terjadi kesalahan.';
    errorBox.classList.remove('hidden');
    return;
  }
  window.open('/receipt/' + data.sale_id, '_blank');
  cart = [];
  renderCart();
  document.getElementById('newCustomerName').value = '';
  document.getElementById('customerSelect').value = '';
  document.getElementById('discountInput').value = 0;
  document.getElementById('paidAmountInput').value = 0;
  setTimeout(() => location.reload(), 600);
});
</script>
</body>
</html>
