<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Struk <%= sale.invoice_no %></title>
<style>
  * { box-sizing: border-box; }
  body { font-family: 'Courier New', monospace; background:#f1f5f9; margin:0; padding:20px; }
  .receipt { width: 320px; background:#fff; margin: 0 auto 24px; padding: 16px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.15); font-size: 13px; }
  .center { text-align:center; }
  .right { text-align:right; }
  .bold { font-weight:bold; }
  .line { border-top: 1px dashed #000; margin: 8px 0; }
  table { width:100%; border-collapse:collapse; }
  td { padding: 1px 0; vertical-align: top; }
  .tag { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:bold; margin-top:4px; }
  .tag-cash { background:#dcfce7; color:#166534; }
  .tag-credit { background:#fee2e2; color:#991b1b; }
  .copy-label { text-align:center; font-weight:bold; letter-spacing:2px; margin-bottom:6px; font-size:12px; color:#475569; }
  .print-btn { display:block; width:320px; margin: 0 auto 16px; padding:10px; background:#15945c; color:#fff; border:none; border-radius:8px; font-weight:bold; cursor:pointer; font-family:Inter,sans-serif; }
  @media print {
    body { background:#fff; padding:0; }
    .no-print { display:none !important; }
    .receipt { box-shadow:none; page-break-after: always; }
  }
</style>
</head>
<body>
  <button class="print-btn no-print" onclick="window.print()">🖨️ Cetak Struk</button>

  <% copies.forEach(copyLabel => { %>
  <div class="receipt">
    <% if (copyLabel) { %><div class="copy-label">— STRUK <%= copyLabel %> —</div><% } %>

    <div class="center bold" style="font-size:15px;">SEROJA DECOR</div>
    <div class="center" style="font-size:11px;">Toko Bahan Bangunan & Dekorasi</div>
    <div class="center" style="font-size:11px;">Jl. Contoh Alamat No. 123, Kota</div>
    <div class="line"></div>

    <table>
      <tr><td>No. Invoice</td><td class="right"><%= sale.invoice_no %></td></tr>
      <tr><td>Tanggal</td><td class="right"><%= dateID(sale.sale_date) %></td></tr>
      <tr><td>Kasir</td><td class="right"><%= sale.created_by ? 'Petugas' : '-' %></td></tr>
    </table>

    <% if (sale.payment_type === 'credit') { %>
      <div class="center"><span class="tag tag-credit">PENJUALAN KREDIT</span></div>
    <% } else { %>
      <div class="center"><span class="tag tag-cash">PENJUALAN TUNAI</span></div>
    <% } %>

    <div class="line"></div>
    <table>
      <% items.forEach(it => { %>
        <tr><td colspan="2"><%= it.product_name %></td></tr>
        <tr><td><%= it.qty %> <%= it.unit %> x <%= rupiah(it.price) %></td><td class="right"><%= rupiah(it.subtotal) %></td></tr>
      <% }) %>
    </table>
    <div class="line"></div>

    <table>
      <tr><td>Subtotal</td><td class="right"><%= rupiah(sale.subtotal) %></td></tr>
      <% if (sale.discount > 0) { %><tr><td>Diskon</td><td class="right">-<%= rupiah(sale.discount) %></td></tr><% } %>
      <tr class="bold"><td style="font-size:14px;">TOTAL</td><td class="right" style="font-size:14px;">Rp <%= rupiah(sale.total) %></td></tr>
    </table>

    <div class="line"></div>

    <% if (sale.payment_type === 'credit') { %>
      <table>
        <tr><td>Customer</td><td class="right bold"><%= sale.customer_name %></td></tr>
        <tr><td>Sudah Dibayar</td><td class="right"><%= rupiah(sale.paid_amount) %></td></tr>
        <tr class="bold"><td>SISA HUTANG</td><td class="right">Rp <%= rupiah(sale.total - sale.paid_amount) %></td></tr>
      </table>
      <div class="line"></div>
      <div class="center" style="font-size:11px;">Harap dilunasi sebelum jatuh tempo.</div>
      <div class="center" style="font-size:11px;">Simpan struk ini sebagai bukti hutang.</div>
    <% } else { %>
      <table>
        <% if (sale.customer_name) { %><tr><td>Customer</td><td class="right"><%= sale.customer_name %></td></tr><% } %>
        <tr><td>Metode Bayar</td><td class="right">
          <%= sale.payment_method === 'cash' ? 'Tunai' : (sale.payment_method === 'transfer_bca' ? 'Transfer BCA' : 'QRIS') %>
        </td></tr>
        <tr><td>Dibayar</td><td class="right"><%= rupiah(sale.paid_amount) %></td></tr>
      </table>
      <div class="line"></div>
      <div class="center" style="font-size:11px;">Terima kasih telah berbelanja</div>
      <div class="center" style="font-size:11px;">di Seroja Decor 🙏</div>
    <% } %>

  </div>
  <% }) %>

  <script>
    window.addEventListener('load', () => { if (location.search.includes('autoprint')) window.print(); });
  </script>
</body>
</html>
