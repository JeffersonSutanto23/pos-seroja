<%- include('partials/layout-head', { title: 'Pembukuan Pembelian' }) %>
<body class="bg-slate-50">
<div class="flex">
  <%- include('partials/sidebar') %>
  <main class="flex-1 min-h-screen">
    <%- include('partials/topbar', { title: 'Pembukuan Pembelian', subtitle: 'Rekap pembelian harian per bulan' }) %>
    <div class="p-6 space-y-4">

      <div class="flex items-center gap-2 overflow-x-auto pb-1">
        <% MONTHS.forEach((m, idx) => { %>
          <a href="/purchases-book?year=<%= year %>&month=<%= idx+1 %>"
             class="px-4 py-2 rounded-lg text-sm font-semibold whitespace-nowrap <%= (idx+1) === month ? 'bg-accent-500 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100' %>">
             <%= m %>
          </a>
        <% }) %>
        <select onchange="location.href='/purchases-book?year='+this.value+'&month=<%= month %>'" class="ml-2 border rounded-lg px-3 py-2 text-sm">
          <% [year-1, year, year+1].forEach(y => { %><option value="<%= y %>" <%= y===year?'selected':'' %>><%= y %></option><% }) %>
        </select>
      </div>

      <div class="card overflow-hidden overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50">
            <tr>
              <th class="border px-3 py-2 text-center">TANGGAL</th>
              <th class="border px-3 py-2 text-center">NAMA SUPPLIER</th>
              <th class="border px-3 py-2 text-center">JUMLAH</th>
              <% topSuppliers.forEach(s => { %><th class="border px-3 py-2 text-center bg-yellow-50"><%= s %></th><% }) %>
            </tr>
          </thead>
          <tbody>
            <% if (purchases.length === 0) { %>
              <tr><td colspan="<%= 3 + topSuppliers.length %>" class="py-8 text-center text-slate-400">Belum ada data pembelian bulan ini.</td></tr>
            <% } %>
            <% purchases.forEach(p => { %>
              <tr>
                <td class="border px-3 py-2"><%= p.purchase_date.split('-').reverse().join('-') %></td>
                <td class="border px-3 py-2"><%= p.supplier_name %></td>
                <td class="border px-3 py-2 text-right"><%= rupiah(p.total) %></td>
                <% topSuppliers.forEach(s => { %>
                  <td class="border px-3 py-2 text-right"><%= s === p.supplier_name ? rupiah(p.total) : '' %></td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="bg-accent-50 font-bold">
              <td class="border px-3 py-2" colspan="2">TOTAL</td>
              <td class="border px-3 py-2 text-right">Rp <%= rupiah(grandTotal) %></td>
              <% topSuppliers.forEach(s => { %>
                <td class="border px-3 py-2 text-right">Rp <%= rupiah(columnTotals[s]) %></td>
              <% }) %>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
